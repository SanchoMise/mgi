---
import PageHero from '../components/PageHero.astro';
import Related from '../components/Related.astro';
import Visual from '../components/Visual.astro';
import { rich } from '../lib/text';
import { getPage } from '../data/pages';
import { SITE } from '../data/site';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
---
<PageHero id={id} />
<section class="section" style="padding-top:0">
  <div class="wrap two">
    <div>
      <h2 style="font-size:1.4rem">Nous trouver</h2>
      <address style="font-style:normal; font-size:1.2rem; margin-bottom:1.5rem">
        {SITE.name}<br />{SITE.streetAddress}<br />{SITE.postalCode} {SITE.city}<br />
        <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
      <p><strong>Horaires :</strong> {SITE.hours}</p>
      <dl class="facts" style="margin-top:1.5rem">{page.facts!.map(([k, v]) => <><dt>{k}</dt><dd set:html={rich(v)} /></>)}</dl>
    </div>
    <aside class="aside">
      <Visual tone="ink" ratio="4 / 3" label="Plan interactif [à intégrer]" />
    </aside>
  </div>
</section>
<Related variant={variant} ids={page.related} />
