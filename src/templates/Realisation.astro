---
import PageHero from '../components/PageHero.astro';
import Related from '../components/Related.astro';
import Visual from '../components/Visual.astro';
import { rich } from '../lib/text';
import { getPage } from '../data/pages';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
---
<PageHero id={id} />
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div>
      <Visual tone="secondary" ratio="16 / 9" label="Photo ou extrait vidéo [à fournir]" />
      <div style="margin-top:1.5rem">{page.body?.map((p) => <p set:html={rich(p)} />)}</div>
    </div>
  </div>
</section>
<Related variant={variant} ids={page.related} />
