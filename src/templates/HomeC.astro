---
// VARIANTE C — HYBRIDE. Un hub par public (trois grandes cartes de parcours qui s'empilent au défilement),
// et à l'intérieur de chaque parcours, des tuiles par discipline : ce sont les pages /stages-ados/photo/, etc.
import Apostrophe from '../components/Apostrophe.astro';
import Visual from '../components/Visual.astro';
import Section from '../components/Section.astro';
import { getPage } from '../data/pages';
import { pathOf } from '../data/variants';
import { SITE } from '../data/site';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
const parcours = [
  {
    cls: 'pub--ado', kicker: 'Je suis parent ou ado', title: 'Trouver un stage', hub: 'stages-ados', cta: 'Tous les stages',
    text: 'Stages pendant les vacances (12-16 ans) et ateliers du samedi : théâtre, photo, vidéo. Prochain rendez-vous : les vacances de la Toussaint, du 19 au 23 octobre 2026.',
    tiles: [
      { id: 'stage-photo', name: 'Photo', sub: 'Stage ados · 12-16 ans' },
      { id: 'stage-video', name: 'Vidéo', sub: 'Stage ados · 12-16 ans' },
      { id: 'stage-theatre', name: 'Théâtre', sub: 'Stage ados · 12-16 ans' },
      { id: 'samedis', name: 'Samedis', sub: 'Écriture, théâtre, vidéo' },
    ],
  },
  {
    cls: 'pub--ecole', kicker: 'Je suis enseignant·e', title: 'Monter un parcours avec ma classe', hub: 'ecoles', cta: 'Tout pour les écoles',
    text: "De la maternelle à la terminale : un parcours sur mesure en théâtre, vidéo ou photographie, construit avec vous et un·e artiste.",
    tiles: [
      { id: 'ateliers-classe', name: 'En classe', sub: "Ateliers : mode d'emploi" },
      { id: 'parcours-croises', name: 'Jeu de Paume', sub: 'Parcours croisés' },
      { id: 'realisations', name: 'Réalisations', sub: 'La galerie des ateliers' },
    ],
  },
  {
    cls: 'pub--pro', kicker: 'Je suis professionnel·le', title: 'Me former, accueillir un projet', hub: 'formations', cta: 'Les 8 formations',
    text: "Formations courtes 2026-2027 pour imaginer et conduire des projets artistiques avec un groupe d'enfants ou d'adolescents.",
    tiles: [
      { id: 'formation-cyanotype', name: 'Photo', sub: 'Le Cyanotype, le Sténopé' },
      { id: 'formation-cinema-animation', name: 'Vidéo', sub: "Cinéma d'animation, audiovisuel" },
      { id: 'formation-oral-aisance-impact', name: 'Théâtre', sub: "Aisance à l'oral, théâtre 3-6 ans" },
      { id: 'formation-creation-sonore', name: 'Son', sub: 'Création sonore' },
    ],
  },
];
---
<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <p class="eyebrow reveal">Paris 1er · Châtelet</p>
      <h1 class="reveal" style="--i:1">{page.h1}</h1>
      <p class="lead reveal" style="--i:2">{page.lead} Stages photo, vidéo et théâtre pour les ados, ateliers en classe, formations pour les professionnel·les.</p>
      <p class="reveal" style="--i:3; display:flex; gap:.75rem; flex-wrap:wrap">
        <a class="btn" href={pathOf(variant, 'stages-ados')}>Trouver un stage <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={pathOf(variant, 'formations')}>Voir les formations</a>
      </p>
    </div>
    <div class="reveal" style="--i:2; position:relative">
      <Visual tone="primary" ratio="1 / 1" label="Vidéo en boucle ou photo [à fournir]" />
    </div>
  </div>
</section>

<div class="marquee" aria-hidden="true"><div class="marquee__track"><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span></div></div>

<!-- Trois parcours : cartes qui s'empilent (position: sticky). Les tuiles sont des liens vers les pages disciplines. -->
<section class="section" aria-labelledby="parcours-titre">
  <div class="wrap">
    <p class="eyebrow reveal">Votre parcours</p>
    <h2 id="parcours-titre" class="reveal">Un site, trois parcours</h2>
    <div class="pstack">
      {parcours.map((p, n) => (
        <article class={`pcard ${p.cls}`} style={`--n:${n}`}>
          <Apostrophe />
          <div class="pcard__intro">
            <p class="pcard__kicker">{p.kicker}</p>
            <h3><a class="pcard__title" href={pathOf(variant, p.hub)}>{p.title}</a></h3>
            <p>{p.text}</p>
            <a class="btn btn--sm pcard__cta" href={pathOf(variant, p.hub)}>{p.cta} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <ul class="pcard__tiles">
            {p.tiles.map((t) => (
              <li>
                <a class="tile" href={pathOf(variant, t.id)}>
                  <span class="tile__name">{t.name}</span>
                  <span class="tile__sub">{t.sub}</span>
                  <span class="tile__go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<Section tone="soft" title="Un lieu au cœur de Paris" eyebrow="Lieu et accès">
  <div class="two">
    <div>
      <p class="lead">1 200 m² dédiés à la pratique : studio théâtre, labo photo, espaces multimédia, cabine d'enregistrement.</p>
      <address style="font-style:normal">{SITE.streetAddress}, {SITE.postalCode} {SITE.city} · Métro Châtelet<br /><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></address>
      <p style="margin-top:1rem"><a class="btn btn--ghost" href={pathOf(variant, 'lieu-acces')}>Lieu et accès</a> <a class="btn btn--ghost" href={pathOf(variant, 'contact')}>Contact</a></p>
    </div>
    <Visual tone="secondary" ratio="16 / 10" label="Photo du lieu [à fournir]" />
  </div>
</Section>
