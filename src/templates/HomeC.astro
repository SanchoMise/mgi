---
import Visual from '../components/Visual.astro';
import Section from '../components/Section.astro';
import Sessions from '../components/Sessions.astro';
import { getPage } from '../data/pages';
import { pathOf } from '../data/variants';
import { SITE } from '../data/site';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
const toussaint = getPage('stages-ados').sessions![0];
const cols = [
  { key: 'ado', id: 'stages-ados', cls: 'pub--ado', kicker: 'Je suis', who: 'Parent ou ado' },
  { key: 'ecole', id: 'ecoles', cls: 'pub--ecole', kicker: 'Je suis', who: 'Enseignant·e' },
  { key: 'pro', id: 'formations', cls: 'pub--pro', kicker: 'Je suis', who: 'Professionnel·le' },
];
const L = (id: string, label: string) => ({ id, label });
const rows = [
  { name: 'Photo', cells: { ado: [L('stage-photo', 'Stage photo ados')], ecole: [L('ateliers-classe', 'Photo en classe')], pro: [L('formation-cyanotype', 'Le Cyanotype'), L('formation-stenope', 'Le Sténopé')] } },
  { name: 'Vidéo', cells: { ado: [L('stage-video', 'Stage vidéo ados')], ecole: [L('ateliers-classe', 'Vidéo en classe')], pro: [L('formation-cinema-animation', "Cinéma d'animation"), L('formation-realisation-audiovisuelle', 'Réalisation audiovisuelle')] } },
  { name: 'Théâtre', cells: { ado: [L('stage-theatre', 'Stage théâtre ados'), L('samedis', 'Ateliers du samedi')], ecole: [L('ateliers-classe', 'Théâtre en classe')], pro: [L('formation-oral-aisance-impact', "Aisance à l'oral"), L('formation-theatre-3-6-ans-album', 'Théâtre 3-6 ans')] } },
  { name: 'Son et danse', cells: { ado: [], ecole: [], pro: [L('formation-creation-sonore', 'Création sonore'), L('formation-mouvement-danse', 'Mouvement et danse')] } },
];
---
<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <p class="eyebrow reveal">Paris 1er · Châtelet</p>
      <h1 class="reveal" style="--i:1">{page.h1}</h1>
      <p class="lead reveal" style="--i:2">{page.lead} Stages photo, vidéo et théâtre pour les ados, ateliers en classe, formations pour les professionnel·les.</p>
      <p class="reveal" style="--i:3; display:flex; gap:.75rem; flex-wrap:wrap">
        <a class="btn" href={pathOf(variant, 'stages-ados')}>Trouver un stage <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={pathOf(variant, 'formations')}>Voir les formations</a>
      </p>
    </div>
    <div class="reveal" style="--i:2; position:relative">
      <Visual tone="primary" ratio="1 / 1" label="Vidéo en boucle ou photo [à fournir]" />
    </div>
  </div>
</section>

<div class="marquee" aria-hidden="true"><div class="marquee__track"><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span><span>Photo</span><span>Vidéo</span><span>Théâtre</span><span>Son</span><span>Danse</span></div></div>

<!-- Matrice : l'hybride rendu visible. Colonnes = parcours par public (hubs). Lignes = disciplines transversales. -->
<section class="section" aria-labelledby="matrice">
  <div class="wrap">
    <p class="eyebrow reveal">Variante C · hybride</p>
    <h2 id="matrice" class="reveal">Trois parcours, toutes les disciplines</h2>
    <p class="lead reveal">Entrez par votre profil (en-têtes de colonne) ou directement par la discipline qui vous intéresse (cellules).</p>
    <table class="matrix reveal">
      <thead>
        <tr>
          <td></td>
          {cols.map((c) => (
            <th scope="col" class={c.cls}><a href={pathOf(variant, c.id)}><small>{c.kicker}</small><span>{c.who}</span><b aria-hidden="true">→</b></a></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.name}</th>
            {cols.map((c) => (
              <td data-label={c.who}>
                {r.cells[c.key].length === 0 ? <span class="matrix__none">—</span> : r.cells[c.key].map((cell) => <a href={pathOf(variant, cell.id)}>{cell.label}</a>)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="muted" style="margin-top:1rem">Les pages sont les mêmes que dans le menu : les disciplines servent le référencement (« stage photo ados Paris »), les parcours servent le visiteur.</p>
  </div>
</section>

<Section tone="soft" title="Prochains stages ados" eyebrow="12-16 ans">
  <Sessions sessions={[toussaint]} cta={{ href: pathOf(variant, 'stages-ados')!, label: 'Voir les stages' }} />
</Section>

<section class="section band">
  <div class="wrap">
    <p class="eyebrow reveal">Professionnel·les</p>
    <h2 class="reveal">Formation professionnelle continue</h2>
    <p class="lead reveal">40 ans d'expérience dans la co-construction de parcours artistiques avec les classes, transmis en formations courtes.</p>
    <p class="reveal"><a class="btn btn--ghost" style="color:inherit;border-color:currentColor" href={pathOf(variant, 'formations')}>Découvrir les 8 formations <span class="arrow" aria-hidden="true">→</span></a></p>
  </div>
</section>

<Section title="Un lieu au cœur de Paris" eyebrow="Lieu et accès">
  <div class="two">
    <div>
      <p class="lead">1 200 m² dédiés à la pratique, studio théâtre, labo photo, espaces multimédia, cabine d'enregistrement.</p>
      <address style="font-style:normal">{SITE.streetAddress}, {SITE.postalCode} {SITE.city} · Métro Châtelet<br /><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></address>
      <p style="margin-top:1rem"><a class="btn btn--ghost" href={pathOf(variant, 'lieu-acces')}>Lieu et accès</a> <a class="btn btn--ghost" href={pathOf(variant, 'contact')}>Contact</a></p>
    </div>
    <Visual tone="secondary" ratio="16 / 10" label="Photo du lieu [à fournir]" />
  </div>
</Section>
