---
import PageHero from '../components/PageHero.astro';
import Related from '../components/Related.astro';
import { getPage } from '../data/pages';
import { SITE } from '../data/site';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
---
<PageHero id={id} />
<section class="section" style="padding-top:0">
  <div class="wrap prose">
    <div>
      <div class="card" style="min-height:0">
        <h2 style="font-size:1.4rem">Nous joindre</h2>
        <p><a class="btn" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>{SITE.hours}</p>
        <address style="font-style:normal">{SITE.streetAddress}, {SITE.postalCode} {SITE.city} · Métro Châtelet</address>
      </div>
      <p class="note" style="margin-top:1rem">Formulaire de contact : <em class="tbd">[à intégrer côté WordPress]</em> (aucun envoi dans ce prototype).</p>
    </div>
  </div>
</section>
<Related variant={variant} ids={page.related} />
