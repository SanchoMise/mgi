---
import Visual from '../components/Visual.astro';
import Apostrophe from '../components/Apostrophe.astro';
import Section from '../components/Section.astro';
import CardGrid from '../components/CardGrid.astro';
import Sessions from '../components/Sessions.astro';
import { getPage } from '../data/pages';
import { pathOf, indexVariant } from '../data/variants';
import { SITE } from '../data/site';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
const has = (i: string) => indexVariant(variant).has(i);
const toussaint = getPage('stages-ados').sessions![0];
const paths = [
  { id: 'stages-ados', who: 'Je suis parent ou ado', text: 'Stages de vacances, ateliers du samedi, dates et inscription.' },
  { id: 'ecoles', who: 'Je suis enseignant·e', text: 'Monter un parcours artistique avec votre classe, voir des réalisations.' },
  { id: 'formations', who: 'Je suis professionnel·le', text: 'Formations 2026-2027 pour animateur·rices, médiateur·rices, artistes.' },
].filter((p) => has(p.id));
---
<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <p class="eyebrow reveal">Paris 1er · Châtelet</p>
      <h1 class="reveal" style="--i:1">{page.h1}</h1>
      <p class="lead reveal" style="--i:2">{page.lead} Stages photo, vidéo et théâtre pour les ados, ateliers en classe, formations pour les professionnel·les.</p>
      <p class="reveal" style="--i:3; display:flex; gap:.75rem; flex-wrap:wrap">
        <a class="btn" href={pathOf(variant, 'stages-ados')}>Trouver un stage <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={pathOf(variant, 'formations')}>Voir les formations</a>
      </p>
    </div>
    <div class="reveal" style="--i:2; position:relative">
      <Visual tone="primary" ratio="1 / 1" label="Vidéo en boucle ou photo [à fournir]" />
    </div>
  </div>
</section>

<!-- Entrées par parcours : vrais liens HTML, pas de choix mémorisé, pas d'interstitiel. -->
<Section title="Par où commencer ?" eyebrow="Choisissez votre parcours">
  <div class="grid grid--3">
    {paths.map((p, n) => (
      <a class={`card card--path is-${n + 1} reveal`} style={`--i:${n}`} href={pathOf(variant, p.id)}>
        <Apostrophe />
        <h3>{p.who}</h3>
        <p>{p.text}</p>
        <span class="go">Entrer <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <p class="muted" style="margin-top:1.25rem">Ces trois accès sont de simples liens : ils n'enferment pas dans un parcours, tout le site reste accessible depuis le menu.</p>
</Section>

{has('disc-photo') && (
  <Section tone="soft" title="Ou choisir une discipline" eyebrow="Variante B">
    <CardGrid variant={variant} ids={['disc-photo', 'disc-video', 'disc-theatre']} />
  </Section>
)}

<Section tone="soft" title="Prochains stages ados" eyebrow="12-16 ans">
  <Sessions sessions={[toussaint]} cta={{ href: pathOf(variant, 'stages-ados')!, label: 'Voir les stages' }} />
  <div style="margin-top:1.5rem"><CardGrid variant={variant} ids={['stage-photo', 'stage-video', 'stage-theatre']} /></div>
</Section>

<section class="section band">
  <div class="wrap">
    <p class="eyebrow reveal">Professionnel·les</p>
    <h2 class="reveal">Formation professionnelle continue</h2>
    <p class="lead reveal">40 ans d'expérience dans la co-construction de parcours artistiques avec les classes, transmis en formations courtes.</p>
    <p class="reveal"><a class="btn btn--ghost" style="color:inherit;border-color:currentColor" href={pathOf(variant, 'formations')}>Découvrir les 8 formations <span class="arrow" aria-hidden="true">→</span></a></p>
  </div>
</section>

<Section title="Un lieu au cœur de Paris" eyebrow="Lieu et accès">
  <div class="two">
    <div>
      <p class="lead">1 200 m² dédiés à la pratique, studio théâtre, labo photo, espaces multimédia, cabine d'enregistrement.</p>
      <address style="font-style:normal">{SITE.streetAddress}, {SITE.postalCode} {SITE.city} · Métro Châtelet<br /><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></address>
      <p style="margin-top:1rem"><a class="btn btn--ghost" href={pathOf(variant, 'lieu-acces')}>Lieu et accès</a> <a class="btn btn--ghost" href={pathOf(variant, 'contact')}>Contact</a></p>
    </div>
    <Visual tone="secondary" ratio="16 / 10" label="Photo du lieu [à fournir]" />
  </div>
</Section>
