---
// Chaque variante a sa propre page d'accueil : c'est ce qui rend la différence d'arborescence visible.
import HomeA from './HomeA.astro';
import HomeB from './HomeB.astro';
import HomeC from './HomeC.astro';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
---
{variant === 'a' ? <HomeA variant={variant} id={id} /> : variant === 'b' ? <HomeB variant={variant} id={id} /> : <HomeC variant={variant} id={id} />}
