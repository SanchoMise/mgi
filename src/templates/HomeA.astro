---
// VARIANTE A — PAR PUBLIC. L'accueil est un hub : quatre grands panneaux, un par visiteur.
// Au survol (ou au focus clavier), un panneau s'ouvre et montre ses sous-pages. Aucune discipline en vedette.
import Apostrophe from '../components/Apostrophe.astro';
import Section from '../components/Section.astro';
import Sessions from '../components/Sessions.astro';
import { getPage } from '../data/pages';
import { pathOf, childrenOf } from '../data/variants';
interface Props { variant: string; id: string; }
const { variant, id } = Astro.props;
const page = getPage(id);
const doors = [
  { id: 'stages-ados', cls: 'pub--ado', who: 'Parents et ados', text: "Un stage pendant les vacances ou les samedis, les dates, l'inscription." },
  { id: 'ecoles', cls: 'pub--ecole', who: 'Enseignants et écoles', text: 'Un parcours artistique avec votre classe, des réalisations à voir.' },
  { id: 'formations', cls: 'pub--pro', who: 'Professionnels', text: "Formations, accueil de tournages, résidences d'artistes." },
  { id: 'maison', cls: 'pub--maison', who: 'La Maison', text: "Qui nous sommes, l'équipe, les partenaires, la presse, le lieu." },
];
const hidden = ['real-cines', 'real-etranges'];
const kids = (id: string) => childrenOf(variant, id).filter((c) => !c.id.startsWith('formation-') && !hidden.includes(c.id)).slice(0, 6);
const toussaint = getPage('stages-ados').sessions![0];
---
<section class="a-intro wrap">
  <p class="eyebrow reveal">Maison du Geste et de l'Image · Paris 1er</p>
  <h1 class="reveal" style="--i:1">{page.h1}</h1>
  <p class="lead reveal" style="--i:2"><strong>Qui êtes-vous ?</strong> Chaque public a son espace. Survolez un panneau pour l'ouvrir.</p>
</section>

<section class="a-panels" aria-label="Choisir son espace">
  {doors.map((d, n) => (
    <article class={`a-panel ${d.cls}`}>
      <Apostrophe />
      <a class="a-panel__main" href={pathOf(variant, d.id)}>
        <span class="a-panel__n">0{n + 1}</span>
        <h2>{d.who}</h2>
        <p>{d.text}</p>
        <span class="a-panel__go" aria-hidden="true">Entrer →</span>
      </a>
      <ul class="a-panel__links">
        {kids(d.id).map((c) => <li><a href={c.path}>{c.label}</a></li>)}
        {d.id === 'formations' && <li><a href={pathOf(variant, 'formations')}>Les 8 formations 2026-2027</a></li>}
      </ul>
    </article>
  ))}
</section>

<Section tone="soft" title="La MGI en bref" eyebrow="Chiffres du site actuel">
  <div class="stats">
    <div class="stat reveal"><strong>1 200 m²</strong><span>dédiés à la pratique, sur trois niveaux</span></div>
    <div class="stat reveal" style="--i:1"><strong>~5 000</strong><span>enfants et ados par an pendant le temps scolaire</span></div>
    <div class="stat reveal" style="--i:2"><strong>40 ans</strong><span>de parcours artistiques avec les classes</span></div>
  </div>
  <div style="margin-top:2rem"><Sessions sessions={[toussaint]} cta={{ href: pathOf(variant, 'stages-ados')!, label: 'Voir les stages' }} /></div>
</Section>
