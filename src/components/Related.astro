---
// « Pour aller plus loin » : toujours en bas de page, pleine largeur, même présentation partout.
// Maillage interne explicite entre pages liées (stage → formation → lieu → contact).
import { pathOf } from '../data/variants';
import { getPage } from '../data/pages';
interface Props { variant: string; ids?: string[]; }
const { variant, ids = [] } = Astro.props;
const items = ids.map((id) => ({ href: pathOf(variant, id), page: getPage(id) })).filter((i) => i.href);
---
{items.length > 0 && (
  <section class="related-band" aria-labelledby="related-title">
    <div class="wrap">
      <h2 id="related-title">Pour aller plus loin</h2>
      <ul>{items.map((i) => <li><a href={i.href}>{i.page.label} <span aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </section>
)}
