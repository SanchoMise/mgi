---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { footerNav, childrenOf, pathOf, indexVariant } from '../data/variants';

interface Props { variant: string; }
const { variant } = Astro.props;
const groups = footerNav(variant);
const idx = indexVariant(variant);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo />
        <address>
          {SITE.streetAddress}<br />{SITE.postalCode} {SITE.city} · Métro Châtelet<br />
          <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
        <p style="margin-top:1rem">{SITE.hours}</p>
      </div>
      {groups.map((g) => (
        <div>
          <h2><a href={g.path}>{g.label}</a></h2>
          <ul>
            {childrenOf(variant, g.id).filter((c) => !c.id.startsWith('formation-') && !['real-cines', 'real-etranges'].includes(c.id)).slice(0, 7).map((c) => <li><a href={c.path}>{c.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name} · {SITE.streetAddress}, {SITE.postalCode} {SITE.city} · {SITE.phone}</span>
      <span>Prototype d'arborescence : non indexé, contenu partiellement factice.</span>
    </div>
  </div>
</footer>
