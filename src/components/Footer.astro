---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { footerNav, childrenOf } from '../data/variants';

interface Props { variant: string; }
const { variant } = Astro.props;
const groups = footerNav(variant);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <Logo />
      <address>
        {SITE.streetAddress}, {SITE.postalCode} {SITE.city} · Métro Châtelet<br />
        <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
      <p class="footer-hours">{SITE.hours}</p>
    </div>
    <nav class="footer-cols" aria-label="Plan du site">
      {groups.map((g) => {
        const kids = childrenOf(variant, g.id).filter((c) => !c.id.startsWith('formation-') && !['real-cines', 'real-etranges'].includes(c.id)).slice(0, 6);
        return (
          <div>
            <h2><a href={g.path}>{g.label}</a></h2>
            {kids.length > 0 && <ul>{kids.map((c) => <li><a href={c.path}>{c.label}</a></li>)}</ul>}
          </div>
        );
      })}
    </nav>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>Prototype d'arborescence : non indexé, contenu partiellement factice.</span>
    </div>
  </div>
</footer>
